# Copy file ini ke .env lalu isi sesuai environment (JANGAN commit .env)

# Port HTTP tool ini
PORT=4100

# Koneksi database staging Sanqua HRSystem
# PENTING: harus DB staging, bukan production - test run insert row sementara
# (di-rollback otomatis) ke tabel tr_employeerequestovertimes.
DB_HOST=10.10.20.5
DB_PORT=5432
DB_NAME=staging_sanqua_hrsystemdb
DB_USER=postgres
DB_PASSWORD=

# Set true kalau Postgres di atas butuh SSL (biasanya false utk koneksi internal network)
DB_SSL=false

# DB kedua di SERVER & CREDENTIAL YANG SAMA di atas, cuma beda nama database -
# tempat master data company sebenarnya (tabel ms_plants). Dipakai bareng dengan
# koneksi utama (lihat services/companyLookup.js).
DB_NAME_ESANQUA=sanqua_esanquadb
